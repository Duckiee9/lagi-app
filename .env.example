# Salin menjadi .env lalu isi. Jangan commit .env.
PORT=3000
NODE_ENV=development

# Koneksi PostgreSQL (salah satu cara)
DATABASE_URL=postgres://postgres:1234@localhost:5432/lagi
# DB_SSL=true

# Isi dengan 64 karakter hex acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Asal frontend yang diizinkan (pisahkan dengan koma). Kosong = same-origin saja.
CORS_ORIGIN=http://localhost:5173

# Kata sandi untuk akun demo (dipakai npm run db:sandi-demo)
DEMO_PASSWORD=demo-lagi-2026
